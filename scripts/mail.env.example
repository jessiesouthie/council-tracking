# Email settings for the meeting pipeline — copy, don't commit.
#
#   cp scripts/mail.env.example ~/.config/council-tracking/mail.env
#   chmod 600 ~/.config/council-tracking/mail.env
#
# With this file in place, scripts/transcribe_meeting.sh mails a copy of every
# summary it writes: the summary in the message body, the .summary.md and the
# full .txt transcript attached. Delete the file (or blank COUNCIL_MAIL_TO) and
# the step goes back to doing nothing.
#
# The same three names exist as repository secrets for the nightly GitHub
# Actions run: Settings → Secrets and variables → Actions.

# Who gets the copy. Comma-separated. No recipient = no mail.
COUNCIL_MAIL_TO=you@example.com

# The sending account.
COUNCIL_SMTP_USER=civicrollcall@gmail.com

# Gmail will NOT accept the account password here. Turn on 2-Step Verification,
# then create a 16-character App Password at
# myaccount.google.com → Security → 2-Step Verification → App passwords,
# and paste it below (spaces optional).
COUNCIL_SMTP_PASS=xxxxxxxxxxxxxxxx

# Optional. Defaults shown; only set these to use something other than Gmail.
#COUNCIL_MAIL_FROM=Civic Roll Call <civicrollcall@gmail.com>
#COUNCIL_SMTP_HOST=smtp.gmail.com
#COUNCIL_SMTP_PORT=587
